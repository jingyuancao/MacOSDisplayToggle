{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./build.sh)",
      "Bash(./scripts/test-blackout.sh)",
      "Bash(./scripts/probe-displays.sh)",
      "Bash(swiftc *)",
      "Bash(macosdisplaytoggle status)",
      "Bash(ioreg *)",
      "Bash(system_profiler *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git remote -v *)"
    ],
    "ask": [
      "Bash(./build.sh --install)",
      "Bash(macosdisplaytoggle only)",
      "Bash(macosdisplaytoggle all)",
      "Bash(macosdisplaytoggle toggle)",
      "Bash(pkill *)"
    ]
  }
}
